# Copy to .env and fill in. .env is git-ignored. NEVER put real secrets in this example file.
# If your Postgres password has special characters (@ : / # ?), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sindibad
PORT=4001
WEB_ORIGIN=http://localhost:5173
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIN_HASH_SECRET=
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: model override (default gemini-3.5-flash-lite) and the simulated Mon e-ID phone (must be false in production)
# GEMINI_MODEL=gemini-3.5-flash-lite
# MON_EID_SIMULATOR=true
